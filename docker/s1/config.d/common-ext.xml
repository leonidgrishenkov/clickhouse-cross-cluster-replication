<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <listen_host>::</listen_host>
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>

    <!-- S1a/S1b: shared Keeper with the main cluster (same ensemble).
         For S1c this file is NOT changed; instead a separate override config
         swaps this zookeeper block to point at keeper-ext-1 instead. See the
         S1c section of report.md. -->
    <zookeeper>
        <node><host>keeper-1</host><port>9181</port></node>
        <node><host>keeper-2</host><port>9181</port></node>
        <node><host>keeper-3</host><port>9181</port></node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl_ext</path>
    </distributed_ddl>

    <interserver_http_credentials>
        <user>interserver</user>
        <password>s1_interserver_secret_change_me</password>
    </interserver_http_credentials>

    <!-- ext_cluster: single shard, single replica (ch-ext-s2r1 removed) -->
    <remote_servers>
        <ext_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-ext-s1r1</host><port>9000</port></replica>
            </shard>
        </ext_cluster>

        <!-- Scenario 6: read-only "DBLink" into the main cluster. The ext node
             is not a replica of anything here; it only forwards queries under
             a read-only account. Credentials live in this file. -->
        <main_link>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>ch-main-s1r1</host><port>9000</port>
                    <user>ro_export_user</user><password>ro_export_pw_change_me</password>
                </replica>
                <replica>
                    <host>ch-main-s1r2</host><port>9000</port>
                    <user>ro_export_user</user><password>ro_export_pw_change_me</password>
                </replica>
            </shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>ch-main-s2r1</host><port>9000</port>
                    <user>ro_export_user</user><password>ro_export_pw_change_me</password>
                </replica>
                <replica>
                    <host>ch-main-s2r2</host><port>9000</port>
                    <user>ro_export_user</user><password>ro_export_pw_change_me</password>
                </replica>
            </shard>
        </main_link>
    </remote_servers>
</clickhouse>
